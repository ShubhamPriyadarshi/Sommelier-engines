<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Without this, dyld strips every DYLD_* variable from the process and
         Sommelier's interposer (frame generation, spatial upscaling, display
         mode restoration) silently never loads. Wine re-executes into
         lib/wine/x86_64-unix/wine, so that binary needs it as much as the
         bin/ loaders do. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- Wine maps and executes Windows code. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
